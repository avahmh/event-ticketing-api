# Production — copy to project root as .env on the VPS:
#   cp deploy/.env.production.example .env

DEBUG=False
SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,YOUR_SERVER_IP
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_HOST=db
DATABASE_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_LOCK_URL=redis://redis:6379/0

RESERVATION_MINUTES=10
EXPIRE_RESERVATIONS_INTERVAL_SECONDS=60
PROCESS_OUTBOX_INTERVAL_SECONDS=30
SEAT_LOCK_TTL_SECONDS=8

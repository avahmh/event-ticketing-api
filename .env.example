# Django — dev defaults; production: see deploy/.env.production.example
DEBUG=True
SECRET_KEY=django-insecure-dev-only-change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (Docker Compose uses host "db"; local without Docker: 127.0.0.1)
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_LOCK_URL=redis://redis:6379/0

# Business logic
RESERVATION_MINUTES=10
EXPIRE_RESERVATIONS_INTERVAL_SECONDS=60
PROCESS_OUTBOX_INTERVAL_SECONDS=30
SEAT_LOCK_TTL_SECONDS=8
